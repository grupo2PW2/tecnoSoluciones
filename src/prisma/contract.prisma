// use prisma-8
model Usuarios {
  id         Int                @id @default(autoincrement())
  username   String             @unique
  password   String
  avatar     String?
  activo     Boolean            @default(true)

  personasId Int
  personas   Personas           @relation(fields: [personasId], references: [id])
  createdAt  DateTime           @default(now()) @onCreate(now())
  updatedAt  temporal.UpdatedAt
}

model Personas {
  id        Int                @id @default(autoincrement())
  nombre    String
  apellido  String
  dni       String             @unique
  ciudad    String
  direccion String
  usuarios  Usuarios[]
  contactos Contactos[]
  clientes  Clientes[]
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

enum TipoContacto {
  TELEFONO
  CORREO
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  OTRO
}

model Contactos {
  id        Int                @id @default(autoincrement())
  tipo      TipoContacto       @default(TELEFONO)
  valor     String             @unique
  principal Boolean            @default(false)

  personaId Int
  persona   Personas           @relation(fields: [personaId], references: [id])
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
}

model Clientes {
  id           Int            @id @default(autoincrement())
  personaId    Int
  persona      Personas       @relation(fields: [personaId], references: [id])
  dispositivos Dispositivos[]
}

enum TipoDispotivo {
  COMPUTADORA
  CELULAR
  LAPTOP
  NOTEBOOK
  TABLET
  SMARTWATCH
  IMPRESORA
  SCANNER
  OTRO
}

model Dispositivos {
  id           Int           @id @default(autoincrement())
  nroSerie     String        @unique
  marca        String
  modelo       String
  imgUrl       String?
  estadoFisico String?

  tipo         TipoDispotivo @default(OTRO)
  clienteId    Int
  cliente      Clientes      @relation(fields: [clienteId], references: [id])
}

enum RolEmpleado {
  ADMIN
  RECEPCION
  TECNICO
}

model Empleados {
  id        Int         @id @default(autoincrement())
  personaId Int
  persona   Personas    @relation(fields: [personaId], references: [id])
  rol       RolEmpleado @default(RECEPCION)
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

enum EstadoOrden {
  RECIBIDO
  EN_PROCESO
  DIAGNOSTICADO
  PENDIENTE_APROBACION
  RECHAZADO
  EN_REPARACION
  LISTO_PARA_ENTREGA
  ENTREGADO
}

enum TipoAjuste {
  DESCUENTO
  RECARGO
  NORMAL
}

model Orden {
  id            Int            @id @default(autoincrement())
  codigoOrden   String         @unique
  prioridad     Prioridad      @default(BAJA)
  ajustePrecio  Float          @default(0.0)
  tipoAjuste    TipoAjuste     @default(NORMAL)
  estado        EstadoOrden    @default(RECIBIDO)
  observaciones String?
  fechaIngreso  DateTime       @default(now()) @onCreate(now())
  fechaEstimada DateTime?
  fechaEntrega  DateTime?

  tecnicoId     Int?
  empleado      Empleados?     @relation(fields: [tecnicoId], references: [id])
  dispositivoId Int
  dispositivo   Dispositivos   @relation(fields: [dispositivoId], references: [id])

  actividades   Actividades[]
  problemas     Problemas[]
  diagnosticos  Diagnosticos[]
}

enum EstadoProcesos {
  PENDIENTE
  EN_PROCESO
  FINALIZADO
  CANCELADO
}

model Actividades {
  id             Int            @id @default(autoincrement())
  precioAplicado Float          @default(0.0)
  estado         EstadoProcesos @default(PENDIENTE)
  observaciones  String?
  fecha          DateTime       @default(now()) @onCreate(now())

  ordenId        Int
  orden          Orden          @relation(fields: [ordenId], references: [id])
  servicioId     Int
  servicio       Servicios      @relation(fields: [servicioId], references: [id])
}

model Servicios {
  id          Int           @id @default(autoincrement())
  nombre      String        @unique
  descripcion String?
  costoBase   Float         @default(0.0)

  actividades Actividades[]
}

model Problemas {
  id          Int     @id @default(autoincrement())
  ordenId     Int
  orden       Orden   @relation(fields: [ordenId], references: [id])
  descripcion String?
}

model Diagnosticos {
  id                Int            @id @default(autoincrement())
  solucionPropuesta String
  costoEstimado     Float          @default(0.0)
  estado            EstadoProcesos @default(PENDIENTE)

  ordenId           Int
  orden             Orden          @relation(fields: [ordenId], references: [id])

  aprobaciones      Aprobaciones[]
}

enum Decision {
  APROBADO
  RECHAZADO
}

model Aprobaciones {
  id             Int          @id @default(autoincrement())
  decision       Decision
  observaciones  String?
  fechaRespuesta DateTime     @default(now()) @onCreate(now())

  diagnosticoId  Int
  diagnostico    Diagnosticos @relation(fields: [diagnosticoId], references: [id])
}

enum EstadoRepuesto {
  DISPONIBLE
  AGOTADO
  EN_REPARACION
  DESCATALOGADO
}

model Repuestos {
  id                 Int                  @id @default(autoincrement())
  sku                String               @unique
  nombre             String
  unidadesCaja       Int                  @default(0)
  imgUrl             String?
  estado             EstadoRepuesto       @default(DISPONIBLE)
  precioActual       Float                @default(0.0)
  createdAt          DateTime             @default(now()) @onCreate(now())
  updatedAt          temporal.UpdatedAt

  detalleMovimientos DetalleMovimientos[]
  detalleRepuestos   DetalleRepuestos[]
  inventario         Inventario[]
}

model DetalleRepuestos {
  id                Int       @id @default(autoincrement())
  precioInstalacion Float     @default(0.0)
  cantidad          Int       @default(1)

  repuestoId        Int
  repuesto          Repuestos @relation(fields: [repuestoId], references: [id])
  ordenId           Int
  orden             Orden     @relation(fields: [ordenId], references: [id])
}

model Inventario {
  id          Int                @id @default(autoincrement())
  repuestoId  Int
  repuesto    Repuestos          @relation(fields: [repuestoId], references: [id])
  stock       Int                @default(0)
  stockMinimo Int                @default(0)
  updatedAt   temporal.UpdatedAt
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  SALIDA_REPARACION
  TRANSFERENCIA
}

model Movimientos {
  id                 Int                  @id @default(autoincrement())
  tipo               TipoMovimiento       @default(SALIDA)
  observaciones      String?
  fecha              DateTime             @default(now()) @onCreate(now())

  detalleMovimientos DetalleMovimientos[]
}

model DetalleMovimientos {
  id             Int         @id @default(autoincrement())
  cantidad       Int         @default(1)
  precioUnitario Float       @default(0.0)

  movimientoId   Int
  movimiento     Movimientos @relation(fields: [movimientoId], references: [id])
  repuestoId     Int
  repuesto       Repuestos   @relation(fields: [repuestoId], references: [id])
}
