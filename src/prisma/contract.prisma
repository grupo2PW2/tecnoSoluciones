// use prisma-8
enum Rol {
  ADMINISTRADOR
  TECNICO
  RECEPCIONISTA
  GERENTE
}

model Usuarios {
  id        Int                @id @default(autoincrement())
  nombre    String
  DNI       String             @unique
  username  String             @unique
  password  String
  avatar    String?
  activo    Boolean            @default(true)
  rol       Rol
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  recepcion Orden[]            @relation("recepcionista")
  tecnico   Orden[]            @relation("tecnico")
}

model Clientes {
  id           Int            @id @default(autoincrement())
  nombre       String
  ciudad       String
  direccion    String?
  contactos    Contactos[]
  dispositivos Dispositivos[]
}

enum TipoContacto {
  TELEFONO
  CORREO
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  OTRO
}

model Contactos {
  id        Int                @id @default(autoincrement())
  tipo      TipoContacto       @default(TELEFONO)
  valor     String             @unique
  principal Boolean            @default(false)
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt

  clienteId Int
  cliente   Clientes           @relation(fields: [clienteId], references: [id])
}

enum TipoDispotivo {
  COMPUTADORA
  CELULAR
  LAPTOP
  NOTEBOOK
  TABLET
  SMARTWATCH
  IMPRESORA
  SCANNER
  OTRO
}

model Dispositivos {
  id        Int           @id @default(autoincrement())
  tipo      TipoDispotivo @default(OTRO)
  marca     String
  modelo    String
  nroSerie  String?       @unique
  imgUrl    String?

  clienteId Int
  cliente   Clientes      @relation(fields: [clienteId], references: [id])
  ordenes   Orden[]
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

enum EstadoOrden {
  RECIBIDO
  EN_PROCESO
  DIAGNOSTICADO
  PENDIENTE_APROBACION
  RECHAZADO
  EN_REPARACION
  LISTO_PARA_ENTREGA
  ENTREGADO
}

enum EstadoPago {
  PENDIENTE
  PAGADO
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  QR
}

model Orden {
  id                   Int                  @id @default(autoincrement())
  codigo               String               @unique
  codigoCliente        String               @unique
  fechaIngreso         DateTime             @default(now()) @onCreate(now())
  problemasReportados  String
  condicionDispositivo String?
  accesoriosRecibidos  String?
  prioridad            Prioridad            @default(BAJA)
  estado               EstadoOrden          @default(RECIBIDO)
  diagnostico          String?
  fechaEstimada        DateTime?
  fechaFinalizacion    DateTime?
  fechaEntrega         DateTime?
  trabajoVerficado     Boolean              @default(false)
  entregaConfirmada    Boolean              @default(false)
  observaciones        String?
  descuentoAplicado    NumericString(10, 2) @default(0.00)
  estadoPago           EstadoPago           @default(PENDIENTE)
  metodoPago           MetodoPago           @default(EFECTIVO)
  fechaPago            DateTime?

  tecnicoId            Int?
  tecnico              Usuarios?            @relation('tecnico', fields: [tecnicoId], references: [id])
  recepcionistaId      Int
  recepcion            Usuarios             @relation('recepcionista', fields: [recepcionistaId], references: [id])
  dispositivoId        Int
  dispositivo          Dispositivos         @relation(fields: [dispositivoId], references: [id])
  servicioSolicitadoId Int?
  servicio             Servicios?           @relation(fields: [servicioSolicitadoId], references: [id])

  actividades          Actividades[]
  movimientos          Movimientos[]
  presupuestos         Presupuestos[]
}

enum EstadoProcesos {
  PENDIENTE
  EN_PROCESO
  FINALIZADO
  CANCELADO
}

model Servicios {
  id                 Int                  @id @default(autoincrement())
  nombre             String               @unique
  descripcion        String?
  precioReferencial  NumericString(10, 2) @default(0.00)
  activo             Boolean              @default(true)

  actividades        Actividades[]
  detallePresupuesto DetallePresupuesto[]
}

model Actividades {
  id                Int                  @id @default(autoincrement())
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  estado            EstadoProcesos       @default(PENDIENTE)
  observaciones     String?
  precioUnitario    NumericString(10, 2) @default(0.00)

  ordenId           Int
  orden             Orden                @relation(fields: [ordenId], references: [id])
  servicioId        Int
  servicio          Servicios            @relation(fields: [servicioId], references: [id])
}

enum EstadoPresupuesto {
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
  CANCELADO
}

model Presupuestos {
  id                 Int                  @id @default(autoincrement())
  version            Int                  @default(1)
  fechaRegistro      DateTime             @default(now()) @onCreate(now())
  fechaVencimiento   DateTime?
  estado             EstadoPresupuesto    @default(PENDIENTE_APROBACION)
  fechaRespuesta     DateTime?
  observaciones      String?

  ordenId            Int
  orden              Orden                @relation(fields: [ordenId], references: [id])

  detallePresupuesto DetallePresupuesto[]
}

model DetallePresupuesto {
  id             Int                  @id @default(autoincrement())
  cantidad       Int                  @default(1)
  precioUnitario NumericString(10, 2) @default(0.00)
  descripcion    String?

  presupuestoId  Int
  presupuesto    Presupuestos         @relation(fields: [presupuestoId], references: [id])
  servicioId     Int
  servicio       Servicios            @relation(fields: [servicioId], references: [id])
  repuestoId     Int?
  repuesto       Repuestos?           @relation(fields: [repuestoId], references: [id])
}

enum EstadoRepuesto {
  DISPONIBLE
  AGOTADO
  EN_REPARACION
  DESCATALOGADO
}

model Repuestos {
  id                 Int                  @id @default(autoincrement())
  sku                String               @unique
  nombre             String
  unidadesCaja       Int                  @default(0)
  imgUrl             String?
  precioReferencial  NumericString(10, 2) @default(0.00)
  costoActual        NumericString(10, 2) @default(0.00)
  estado             EstadoRepuesto       @default(DISPONIBLE)
  createdAt          DateTime             @default(now()) @onCreate(now())
  updatedAt          temporal.UpdatedAt

  detalleMovimientos DetalleMovimientos[]
  inventario         Inventario[]
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  SALIDA_REPARACION
  SALIDA_VENTA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

model Movimientos {
  id                 Int                  @id @default(autoincrement())
  tipo               TipoMovimiento       @default(SALIDA)
  fecha              DateTime             @default(now()) @onCreate(now())
  observaciones      String?

  detalleMovimientos DetalleMovimientos[]
  ordenId            Int?
  orden              Orden?               @relation(fields: [ordenId], references: [id])
  updatedAt          temporal.UpdatedAt
}

model DetalleMovimientos {
  id             Int                   @id @default(autoincrement())
  cantidad       Int
  costoUnitario  NumericString(10, 2)  @default(0.00)
  precioUnitario NumericString(10, 2)? @default(0.00)

  movimientoId   Int
  movimiento     Movimientos           @relation(fields: [movimientoId], references: [id])
  repuestoId     Int
  repuesto       Repuestos             @relation(fields: [repuestoId], references: [id])
}

model Inventario {
  id          Int                @id @default(autoincrement())
  repuestoId  Int                @unique()
  repuesto    Repuestos          @relation(fields: [repuestoId], references: [id])
  stock       Int                @default(0)
  stockMinimo Int                @default(0)
  updatedAt   temporal.UpdatedAt
}
