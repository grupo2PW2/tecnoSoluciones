// use prisma-8
enum Rol {
  ADMINISTRADOR
  TECNICO
  RECEPCIONISTA
  GERENTE
}

model Usuarios {
  id                     Int                @id @default(autoincrement())
  nombre                 String
  apellido               String
  DNI                    String             @unique
  telefono               String?
  username               String             @unique
  password               String
  avatar                 String?
  activo                 Boolean            @default(true)
  rol                    Rol
  createdAt              DateTime           @default(now()) @onCreate(now())
  updatedAt              temporal.UpdatedAt

  recepcion              Orden[]            @relation("recepcionista")
  tecnico                Orden[]            @relation("tecnico")
  ordenesEntregadas      Orden[]            @relation("entregadoPor")
  movimientosRegistrados Movimientos[]
}

model Clientes {
  id           Int                @id @default(autoincrement())
  nombre       String
  apellido     String
  telefono     String?
  direccion    String?
  createdAt    DateTime           @default(now()) @onCreate(now())
  updatedAt    temporal.UpdatedAt

  dispositivos Dispositivos[]
}

enum TipoDispotivo {
  COMPUTADORA
  CELULAR
  LAPTOP
  TABLET
  SMARTWATCH
  IMPRESORA
  SCANNER
  OTRO
}

model Dispositivos {
  id        Int           @id @default(autoincrement())
  tipo      TipoDispotivo @default(OTRO)
  marca     String
  modelo    String
  nroSerie  String?       @unique
  imgUrl    String?

  clienteId Int
  cliente   Clientes      @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  ordenes   Orden[]
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

enum EstadoOrden {
  RECIBIDO // EN ESPERA DE DIAGNOSTICO
  EN_DIAGNOSTICO // TECNICO ESTA DIAGNOSTICANDO EL DISPOSITIVO
  PENDIENTE_APROBACION //DIAGNOSTICO TERMINADO, ESPERANDO APROBACION DEL CLIENTE
  APROBADO // CLIENTE APROBO EL DIAGNOSTICO Y SE AUTORIZA EL TRABAJO
  RECHAZADO // CLIENTE RECHAZO EL DIAGNOSTICO Y NO SE AUTORIZA EL TRABAJO
  RECHAZADO_ENTREGADO // CLIENTE RECHAZO EL DIAGNOSTICO Y SE ENTREGARA EL DISPOSITIVO SIN REPARAR
  EN_REPARACION // TECNICO ESTA REPARANDO EL DISPOSITIVO
  LISTO // EL TRABAJO ESTA TERMINADO VERIFICADO Y LISTO PARA SER ENTREGADO AL CLIENTE
  ENTREGADO // EL FUE REPARADO Y FUE ENTREGADO AL CLIENTE
  CANCELADO // EL TRABAJO FUE CANCELADO POR LA EMPRESA
}

model Orden {
  id                   Int                   @id @default(autoincrement())
  codigo               String                @unique
  codigoCliente        String                @unique
  fechaIngreso         DateTime              @default(now()) @onCreate(now())
  problemasReportados  String
  condicionDispositivo String?
  accesoriosRecibidos  String?
  estado               EstadoOrden           @default(RECIBIDO)
  motivoCancelacion    String?

  fechaCierreTecnico   DateTime?
  fechaEntregaCliente  DateTime?
  montoCobrado         NumericString(10, 2)?

  entregadoPorId       Int?
  entregadoPor         Usuarios?             @relation("entregadoPor", fields: [entregadoPorId], references: [id], onDelete: Restrict)
  tecnicoId            Int?
  tecnicoResponsable   Usuarios?             @relation("tecnico", fields: [tecnicoId], references: [id], onDelete: Restrict)
  recepcionistaId      Int
  recepcionadoPor      Usuarios              @relation("recepcionista", fields: [recepcionistaId], references: [id], onDelete: Restrict)
  dispositivoId        Int
  dispositivo          Dispositivos          @relation(fields: [dispositivoId], references: [id], onDelete: Restrict)

  movimientos          Movimientos[]
  presupuestos         Presupuestos[]

  @@index([tecnicoId, fechaCierreTecnico])
}

model Servicios {
  id                   Int                   @id @default(autoincrement())
  nombre               String                @unique
  descripcion          String?
  precioReferencial    NumericString(10, 2)  @default(0.00)
  activo               Boolean               @default(true)

  presupuestoServicios PresupuestoServicio[]
}

enum EstadoPresupuesto {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  RECHAZADO
  VENCIDO
  CANCELADO
}

enum TipoPresupuesto {
  PRINCIPAL
  ADICIONAL
}

enum CanalRespuestaPresupuesto {
  EN_TIENDA
  WEB
}

model Presupuestos {
  id                   Int                        @id @default(autoincrement())
  version              Int                        @default(1)
  tipo                 TipoPresupuesto            @default(PRINCIPAL)
  estado               EstadoPresupuesto          @default(BORRADOR)
  fechaRegistro        DateTime                   @default(now()) @onCreate(now())
  fechaPresentacion    DateTime?
  fechaVencimiento     DateTime?
  fechaEstimadaEntrega DateTime?
  fechaRespuesta       DateTime?
  canalRespuesta       CanalRespuestaPresupuesto?
  observaciones        String?

  prioridad            Prioridad                  @default(BAJA)
  porcentajeRecargo    NumericString(5, 2)        @default(0.00)
  montoRecargo         NumericString(10, 2)       @default(0.00)
  descuentoDiagnostico NumericString(10, 2)       @default(0.00)
  total                NumericString(10, 2)?

  ordenId              Int
  orden                Orden                      @relation(fields: [ordenId], references: [id], onDelete: Restrict)

  presupuestoRepuestos PresupuestoRepuesto[]
  presupuestoServicios PresupuestoServicio[]

  @@unique([ordenId, version])
}

enum EstadoRepuesto {
  DISPONIBLE
  AGOTADO
  EN_REPOSICION
  DESCATALOGADO
}

model Repuestos {
  id                 Int                  @id @default(autoincrement())
  sku                String               @unique
  nombre             String
  unidadesCaja       Int                  @default(0)
  imgUrl             String?
  precioVenta        NumericString(10, 2) @default(0.00)
  costoActual        NumericString(10, 2) @default(0.00)
  estado             EstadoRepuesto       @default(DISPONIBLE)
  createdAt          DateTime             @default(now()) @onCreate(now())
  updatedAt          temporal.UpdatedAt

  detalleMovimientos DetalleMovimientos[]
  inventario         Inventario[]
}

model PresupuestoRepuesto {
  presupuestoId  Int
  repuestoId     Int
  cantidad       Int                  @default(1)
  precioUnitario NumericString(10, 2) @default(0.00)
  presupuesto    Presupuestos         @relation(fields: [presupuestoId], references: [id], onDelete: Restrict)
  repuesto       Repuestos            @relation(fields: [repuestoId], references: [id], onDelete: Restrict)

  @@id([presupuestoId, repuestoId])
}

enum EstadoServicioPresupuesto {
  PRESUPUESTADO
  PENDIENTE_EJECUCION
  EN_PROCESO
  FINALIZADO
  CANCELADO
}

model PresupuestoServicio {
  presupuestoId     Int
  servicioId        Int
  cantidad          Int                       @default(1)
  precioUnitario    NumericString(10, 2)
  estado            EstadoServicioPresupuesto @default(PRESUPUESTADO)
  fechaInicio       DateTime?
  fechaFinalizacion DateTime?
  observaciones     String?
  trabajoVerificado Boolean                   @default(false)

  presupuesto       Presupuestos              @relation(fields: [presupuestoId], references: [id], onDelete: Restrict)
  servicio          Servicios                 @relation(fields: [servicioId], references: [id], onDelete: Restrict)

  @@id([presupuestoId, servicioId])
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  SALIDA_REPARACION
  SALIDA_VENTA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

model Movimientos {
  id                 Int                  @id @default(autoincrement())
  tipo               TipoMovimiento       @default(SALIDA)
  fecha              DateTime             @default(now()) @onCreate(now())
  observaciones      String?
  registradoPorId    Int

  registradoPor      Usuarios             @relation(fields: [registradoPorId], references: [id], onDelete: Restrict)
  detalleMovimientos DetalleMovimientos[]
  ordenId            Int?
  orden              Orden?               @relation(fields: [ordenId], references: [id], onDelete: Restrict)
  updatedAt          temporal.UpdatedAt
}

model DetalleMovimientos {
  id             Int                   @id @default(autoincrement())
  cantidad       Int
  costoUnitario  NumericString(10, 2)  @default(0.00)
  precioUnitario NumericString(10, 2)? @default(0.00)

  movimientoId   Int
  movimiento     Movimientos           @relation(fields: [movimientoId], references: [id], onDelete: Restrict)
  repuestoId     Int
  repuesto       Repuestos             @relation(fields: [repuestoId], references: [id], onDelete: Restrict)
}

model Inventario {
  id          Int                @id @default(autoincrement())
  repuestoId  Int                @unique()
  repuesto    Repuestos          @relation(fields: [repuestoId], references: [id], onDelete: Restrict)
  stock       Int                @default(0)
  stockMinimo Int                @default(0)
  updatedAt   temporal.UpdatedAt
}

model Configuracion {
  id             Int                 @id @default(autoincrement())
  margenGanancia NumericString(5, 2) @default(0.00)
  updatedAt      temporal.UpdatedAt
}
